# Copie para .env.android (npm run android:sync usa este arquivo no build da tela do app nativo)
# URL pública da API (o app nativo chama o servidor por ela)
VITE_API_URL=https://trato.seudominio.com.br
# Chave PÚBLICA do SDK do RevenueCat para Android (Project settings → API keys → Google Play, começa com goog_)
VITE_REVENUECAT_ANDROID_KEY=
VITE_LINK_LOJA=https://play.google.com/store/apps/details?id=com.coutodev.trato
