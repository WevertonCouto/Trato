# Porta da API (no dev o Vite repassa /api para ela; em produção ela serve a tela também)
API_PORT=4410
WEB_PORT=5180
# Pasta do banco e das fotos de comprovação
DATA_DIR=./data
# Fuso usado para "hoje", horários e sequência de dias
TZ=America/Sao_Paulo
# Origens que podem chamar a API de fora (app nativo do Capacitor)
CORS_ORIGINS=https://localhost,capacitor://localhost,http://localhost

# RevenueCat (assinaturas). Chaves só aqui, nunca no código.
# Secret API key (v1) do projeto: o servidor confirma cada evento em GET /subscribers/{id}
REVENUECAT_API_KEY=
# Valor configurado no campo "Authorization header" do webhook no painel do RevenueCat
REVENUECAT_WEBHOOK_SECRET=
# Entitlement que libera o Plano Família
REVENUECAT_ENTITLEMENT=familia
